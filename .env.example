# The PNYX API. On a physical Android device over USB, run:
#   adb reverse tcp:4000 tcp:4000
# and leave this as 127.0.0.1. Otherwise use your PC's LAN address,
# e.g. http://192.168.1.20:4000
#
# Leave it blank to run the app offline against the built-in sample data
# (a development setup only: there is no sign-in without a server).
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000

# Native Google Sign-In (the system account picker instead of a browser).
# Requires a custom dev build — these do nothing in Expo Go. See
# docs/DEVELOPMENT.md → "Sign in with Google" for how to create these client IDs.
# Leave both blank to keep using the browser-based flow everywhere.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Beta analytics (PostHog). See docs/DEVELOPMENT.md → "Analytics". Leave the key
# blank to run with analytics fully disabled.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
