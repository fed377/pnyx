{
  "expo": {
    "name": "PNYX",
    "slug": "pnyx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pnyx",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/AppIcon.icon",
      "bundleIdentifier": "com.villari.pnyx",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.villari.pnyx"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F0EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-image",
      "expo-web-browser",
      "expo-notifications",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.631658990231-rvu80d47p7c3vaee9o3dnskfd6vgrdof"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F2F0EC",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c36aa772-e0e0-4a3b-8e2e-5dacdfa48e97"
      }
    },
    "owner": "pnyx-team"
  }
}
